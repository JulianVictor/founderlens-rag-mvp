# FounderLens AI RAG MVP — example environment configuration.
#
# Copy to .env for local use. .env is git-ignored; never commit real secrets.
#
# Ingestion, retrieval, evaluation validation and the default tests need NO
# API credentials.

# --- OpenAI (Stage 4, Commit 5.1) ---
# Read only when the live OpenAIProvider is constructed. Placeholder only;
# never commit a real key. The model is fixed in code
# (founderlens.generation.config, gpt-5.4-mini-2026-03-17), not here.
# OPENAI_API_KEY=your-api-key-here
#
# Opt-in PAID live smoke test (tests/test_generation_openai_live.py).
# A key alone never enables it.
# FOUNDERLENS_RUN_LIVE_LLM_TESTS=1

# --- Optional: project root override ---
# Absolute path to the repository. Only needed for non-editable installs,
# where the project root cannot be discovered automatically.
# FOUNDERLENS_PROJECT_ROOT=
