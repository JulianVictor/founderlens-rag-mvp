# FounderLens AI RAG MVP — example environment configuration.
#
# Copy to .env for local use. .env is git-ignored; never commit real secrets.
#
# Stage 1 requires NO API credentials. Nothing in the current code reads the
# OpenAI variables below; they are placeholders for Stage 4 (grounded generation).

# --- Future: OpenAI (Stage 4+) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Optional: project root override ---
# Absolute path to the repository. Only needed for non-editable installs,
# where the project root cannot be discovered automatically.
# FOUNDERLENS_PROJECT_ROOT=
